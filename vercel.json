{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|chat).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.py": {
      "includeFiles": "backend/**",
      "maxDuration": 30
    }
  }
}
